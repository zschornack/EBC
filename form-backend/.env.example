PORT=3000
# Origins allowed to call the API (no path, no trailing slash). Comma-separated.
ALLOWED_ORIGINS=http://localhost:5500,https://YOURUSER.github.io
DB_PATH=./data.db

# Email (Resend). Without RESEND_API_KEY emails are only logged (dev mode).
RESEND_API_KEY=
MAIL_FROM=Seu Site <contato@seudominio.com>
NOTIFY_TO=voce@seudominio.com

# Optional: Cloudflare Turnstile secret. Leave empty to disable.
TURNSTILE_SECRET=
