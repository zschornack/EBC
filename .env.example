# CONFIGURAÇÕES DO BACKEND
# Estes valores são cadastrados no painel da Cloudflare (Workers → englishbookclub → Configurações → Variáveis e segredos).
# NUNCA coloque os valores reais neste arquivo nem no GitHub.

# Planilha do Google (lista oficial de leads)
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEET_SECRET=uma-senha-longa-e-aleatoria

# Resend (e-mail de aviso para a cliente)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
MAIL_FROM=English Book Club <site@seudominio.com.br>
LEAD_TO_EMAIL=email.da.cliente@exemplo.com

# Turnstile (anti-robô) — a "Site Key" vai no index.html; aqui vai a "Secret Key"
TURNSTILE_SECRET=0x4AAAAAAAxxxxxxxxxxxxxxxx
